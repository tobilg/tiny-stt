{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Never rewrite licensed upstream bytes, integrity metadata, or generated output.
      "!!**/vendor",
      "!!**/dist",
      "!!artifacts",
      "!!**/node_modules",
      "!!**/.cache",
      "!!plans",
      "!!pnpm-lock.yaml",
      "!!packages/whistle/asset-lock.json",
      "!!packages/documentation/evidence.json",
      "!!packages/demo/public/whistle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all" }
  },
  "html": { "formatter": { "enabled": true } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
